# JARVIS n'a pas besoin de fichier .env : les secrets vont dans le trousseau macOS
# (Sécurité > Secrets dans l'interface). Variables facultatives :
JARVIS_PORT=8765            # port local de l'API et de l'interface
# JARVIS_DATA_DIR=           # dossier des données (défaut : ./data)
# JARVIS_WORKSPACE=          # espace de travail (défaut : ./workspace)
# JARVIS_TEST_REEL=1         # active les tests avec le vrai fournisseur IA
